{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPublicPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::razvan-cloudsec-lab-23345",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "public",
            "public/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadPublicObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::razvan-cloudsec-lab-23345/public/*"
    }
  ]
}
